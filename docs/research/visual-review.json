    "布局": {
      "score": 9,
      "basis": "五个任务页独立，专业结果保持主工作面；长计划正常纵向滚动，无横向溢出"
    },
    "间距与对齐": {
      "score": 9,
      "basis": "需求表、操作、依赖图和批次沿同一边缘组织，窄窗重排"
    },
    "排版": {
      "score": 9,
      "basis": "实际计算字号最多四档且不小于12px，中文标签不截断关键状态"
    },
    "颜色": {
      "score": 9,
      "basis": "共享Radix浅暗语义及连续渐变，未知与阻塞可读，减少透明度降级实色"
    },
    "控件状态": {
      "score": 9,
      "basis": "异步结果、空页、选场、导出取消、冲突与恢复均有实际断言"
    },
    "交互": {
      "score": 9,
      "basis": "固定版本查看、专业操作、键盘、CAS保留、导出及关闭重开完整旅程通过"
    }
  },
  "judgment": "基于实际工作面和尺寸行为的设计判断，不是自动像素认证",
